# Segue backend configuration. Copy to .env and fill in.

# Session cookie signing key — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Public origin the browser hits (no trailing slash). Locally this is the Vite dev URL.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Spotify (read side) ---
# Create an app at https://developer.spotify.com/dashboard
# Add redirect URI:  <PUBLIC_BASE_URL>/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- YouTube Music (write side) ---
# Google Cloud Console → Credentials → Create OAuth client ID
#   Application type: "TVs and Limited Input devices"
#   Enable the "YouTube Data API v3" for the project (authorizes the session only;
#   actual calls use YT Music's internal endpoints, so there is NO daily quota).
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=

# --- Transfer pacing (avoid YT Music soft rate-limiting on large runs) ---
MATCH_SLEEP_SECONDS=0.3
ADD_BATCH_SIZE=100
ADD_SLEEP_SECONDS=1.0
